{
  "schemaVersion": 1,
  "specVersion": "ai-fighter-side-v1",
  "status": "authoring-contract",
  "files": {
    "guide": "README.md",
    "schema": "fighter.schema.json",
    "example": "example.fighter.json"
  },
  "input": {
    "manifest": "fighter.json",
    "assetsDirectory": "assets",
    "animationMetadata": "inline:clips",
    "imageEncoding": "static-webp-with-alpha",
    "frameIndex": "zero-based-row-major",
    "originUnit": "frame-local-pixels",
    "durationUnit": "milliseconds",
    "frames": "contiguous-zero-based",
    "landmarks": "sequence-step-indices-except-borrowed-frame",
    "mirror": "right-source-left-runtime-flip",
    "bodyHeight": 400,
    "cameraElevationDegrees": 16
  },
  "limits": {
    "jsonBytes": 262144,
    "assetBytes": 4000000,
    "packageAssetBytes": 10000000,
    "assetCount": 16,
    "imageDimension": 4096,
    "imagePixels": 16777216,
    "packagePixels": 33554432,
    "clipDurationMs": 10000
  },
  "motions": {
    "idle": {
      "kind": "gait",
      "frames": 1,
      "loop": false,
      "purpose": "정지 전신. 모든 동작과 같은 정체성."
    },
    "walk": {
      "kind": "gait",
      "frames": 16,
      "loop": true,
      "purpose": "걷기 한 주기. 양발 교대, 같은 접지 기준."
    },
    "run": {
      "kind": "gait",
      "frames": 12,
      "loop": true,
      "purpose": "달리기 한 주기. 양발 교대."
    },
    "fightIdle": {
      "kind": "action",
      "loop": true,
      "minHits": 0,
      "maxHits": 0,
      "purpose": "전투 준비 자세 반복."
    },
    "combo": {
      "kind": "action",
      "loop": false,
      "minHits": 3,
      "maxHits": 8,
      "purpose": "3개 구간으로 나누어 재생할 연타. 접촉 시점 최소 3개."
    },
    "slam": {
      "kind": "action",
      "loop": false,
      "minHits": 1,
      "maxHits": 1,
      "purpose": "강타의 준비·접촉·회수."
    },
    "dash": {
      "kind": "action",
      "loop": false,
      "minHits": 0,
      "maxHits": 1,
      "purpose": "돌진. 준비와 회수는 같은 선수의 명시한 프레임 사용."
    },
    "block": {
      "kind": "action",
      "loop": false,
      "minHits": 1,
      "maxHits": 1,
      "purpose": "가드와 막기. 접촉 직전 단계가 유지 자세."
    },
    "hit": {
      "kind": "action",
      "loop": false,
      "minHits": 1,
      "maxHits": 1,
      "purpose": "피격·뒤로 젖힘·비틀거림·복귀."
    },
    "groggy": {
      "kind": "action",
      "loop": true,
      "minHits": 0,
      "maxHits": 0,
      "purpose": "기절/흔들림 반복."
    },
    "fall": {
      "kind": "action",
      "loop": false,
      "minHits": 1,
      "maxHits": 1,
      "purpose": "넘어짐·착지·누움. 일어서기 프레임도 명시."
    }
  },
  "combatKits": [
    {
      "id": "standard-duel",
      "description": "서버가 관리하는 기본 대결 규칙. 제작자는 HP·피해·사거리·코드·AI 지시를 제출하지 않는다.",
      "integration": "pending-game-integration",
      "currentConsumers": {
        "player": "FighterFightSkin / Lupin rules",
        "opponent": "NativeCityKumaArt / CityFighters rules"
      },
      "warning": "현재 플레이어와 AI 상대 규칙은 다르다. 이 ID는 서버 연결 계약이며 통합 경쟁 규칙 구현을 뜻하지 않는다."
    }
  ],
  "validationStages": [
    "schema",
    "references-and-geometry",
    "bytes-hashes-and-full-decode",
    "runtime-preview",
    "visual-review",
    "server-registration"
  ],
  "notClientFields": [
    "ownerId",
    "fighterId",
    "approved",
    "runtimeApproved",
    "status",
    "hp",
    "damage",
    "script"
  ],
  "registration": {
    "available": false,
    "reason": "오프라인 제작 계약. 연결된 서버의 /spec에서 베타 등록 가능 여부를 확인한다. 게임 동적 로딩은 별도다."
  }
}
