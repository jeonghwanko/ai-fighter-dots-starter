{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "api/**/*.mjs",
    "worker/**/*.mjs"
  ]
}
