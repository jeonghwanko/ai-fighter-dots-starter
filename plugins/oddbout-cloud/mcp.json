{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "oddbout": {
      "type": "streamable-http",
      "url": "https://mcp.oddbout.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email",
              "profile"
            ],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
